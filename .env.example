# Local development environment variables.


# --- Public-facing variables (NEXT_PUBLIC_ = exposed to the browser, no secrets) ---
NEXT_PUBLIC_GRAPHQL_URL=https://master.shamanicca.com/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://master.shamanicca.com/graphql
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WC_STORE_URL=https://master.shamanicca.com
NEXT_PUBLIC_WP_BASE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ENABLED=false

# --- WordPress / WooCommerce (server-side) ---
GRAPHQL_ENDPOINT=https://master.shamanicca.com/graphql
WORDPRESS_API_URL=
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WP_HOME_SLUG=
WP_SITE_SETTINGS_SLUG=
WP_HTTP_AUTH_USER=
WP_HTTP_AUTH_PASS=

# --- Email (Resend — contact form) ---
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=

# --- Brevo Email List Subscription ---
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# DOI return URL; production: https://shamanicca.com/newsletter?confirmed=1
BREVO_DOI_REDIRECT_URL=http://localhost:3000/newsletter?confirmed=1

# --- Local dev convenience ---
NODE_ENV=development
PORT=3000
